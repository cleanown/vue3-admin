{
  "compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["ESNext","DOM"],
		"baseUrl": ".",
		"paths": {
			"@/*": ["src/*"]
		},
		"types": ["element-plus/global", "vite/client"],
		"noEmit": true,
		"skipLibCheck": true
	},
	"include": ["src", "types"],
}
